# FocusFlow — local environment
# Copy this file to .env and fill in your values. NEVER commit .env.
# Spring Boot loads this .env file automatically for local development.

# Database: choose exactly one at startup: mysql or postgres
# MySQL is the default for local development.
DB_TYPE=mysql
DB_URL=jdbc:mysql://localhost:3306/focusflow?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# AI features
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional Hibernate schema setting
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# PostgreSQL alternative:
# DB_TYPE=postgres
# DB_URL=jdbc:postgresql://localhost:5432/focusflow
# DB_USERNAME=postgres
# DB_PASSWORD=your_postgres_password
