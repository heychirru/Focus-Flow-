# FocusFlow — local environment
# Copy this file to .env and fill in your values. NEVER commit .env.

# Database: choose exactly one at startup: mysql or postgres
DB_TYPE=postgres
DB_URL=jdbc:postgresql://localhost:5432/focusflow
DB_USERNAME=postgres
DB_PASSWORD=postgres

# AI features
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional Hibernate schema setting
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# For MySQL, use for example:
# DB_TYPE=mysql
# DB_URL=jdbc:mysql://localhost:3306/focusflow?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=your_password
