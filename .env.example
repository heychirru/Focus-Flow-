# FocusFlow AI — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# Required: Anthropic API key for AI Coach + Study Coach services
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Database passwords (default: postgres)
SESSION_DB_PASSWORD=postgres
STUDY_DB_PASSWORD=postgres

# Optional: Internal service URL (used inside Docker network)
SESSION_SERVICE_URL=http://session-service:8081
